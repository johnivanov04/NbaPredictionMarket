# BALLDONTLIE API key (required for NBA game ingestion).
# Create a free key at https://app.balldontlie.io -- the free tier is rate
# limited to 5 requests/minute, which the client throttles for automatically.
BALLDONTLIE_API_KEY=your_key_here

# Kalshi public market metadata needs no credentials, so these are optional.
# Only set them if your account/plan requires authenticated market reads.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=

# Optional overrides
# NBA_PM_DATA_DIR=data
# BALLDONTLIE_MIN_INTERVAL_SECONDS=12.5
# KALSHI_MIN_INTERVAL_SECONDS=0.2
